{
  "uid": "rag-overview", "title": "RAG Operations", "schemaVersion": 39, "version": 1,
  "refresh": "15s", "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "HTTP requests / second", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (status) (rate(rag_http_requests_total[5m]))"}]},
    {"id": 2, "title": "HTTP p95 latency", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_http_request_duration_seconds_bucket[5m])))"}]},
    {"id": 3, "title": "Queries", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (status) (rag_queries_total)"}]},
    {"id": 4, "title": "Document tasks", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (status) (rag_tasks_total)"}]},
    {"id": 5, "title": "Mean retrieval count", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "rate(rag_retrieval_documents_sum[5m]) / rate(rag_retrieval_documents_count[5m])"}]},
    {"id": 6, "title": "Document processing p95", "type": "timeseries", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_document_processing_seconds_bucket[5m])))"}]}
  ]
}
