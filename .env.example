# =============================================================================
# Enterprise Knowledge RAG Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ============================
# Application
# ============================
APP_NAME="Enterprise Knowledge RAG Agent"
APP_VERSION=1.0.0
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ============================
# Database (PostgreSQL)
# ============================
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/rag_agent
DATABASE_URL_SYNC=postgresql://rag_user:rag_password@localhost:5432/rag_agent

# ============================
# OpenAI
# ============================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60

# ============================
# Vector Store
# ============================
VECTOR_STORE_TYPE=pgvector    # pgvector | milvus | chroma
VECTOR_STORE_DIMENSIONS=1536
VECTOR_STORE_INDEX_TYPE=hnsw  # hnsw | ivfflat
# Milvus (if using)
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_COLLECTION_NAME=rag_documents

# ============================
# Redis / Celery
# ============================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================
# MinIO / S3
# ============================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_USE_SSL=false

# ============================
# JWT Auth
# ============================
JWT_SECRET_KEY=change-me-to-a-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================
# CORS
# ============================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ============================
# RAG Configuration
# ============================
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Hybrid Search (Phase 2)
RAG_HYBRID_SEARCH_ENABLED=false
RAG_HYBRID_TOP_K=20              # Documents recalled per path in hybrid mode

# Reranker (Phase 2)
RAG_RERANKER_ENABLED=false
RAG_RERANKER_PROVIDER=cohere       # cohere | bge | jina
# RAG_COHERE_API_KEY=your-cohere-api-key
# RAG_JINA_API_KEY=your-jina-api-key

# Query Rewrite (Phase 2)
RAG_QUERY_REWRITE_ENABLED=false
RAG_MULTI_QUERY_ENABLED=false
RAG_MULTI_QUERY_COUNT=3
RAG_QUERY_REWRITE_MODEL=gpt-4o-mini

# ============================
# LangSmith (Observability)
# ============================
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=rag-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ============================
# Prometheus / Metrics
# ============================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================
# Rate Limiting
# ============================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_API_KEY_PER_MINUTE=300

# ============================
# Frontend
# ============================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Enterprise RAG Agent
